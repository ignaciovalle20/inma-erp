# Copy to .env.local (never commit it) and fill in the values of the Supabase
# project this environment should talk to. Find them in the Dashboard under
# Project Settings > API.
#
#   local dev / Vercel Preview  ->  the DEV project    (ref sczgankronafrxybpvnh)
#   Vercel Production           ->  the PROD project   (ref jxkfpkgyvjiyufmfxsfp)
#
# Vercel: set each variable per environment (Production vs Preview) in the
# project settings so a preview deploy never points at production.

# Project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / publishable key. Public by design: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET, bypasses RLS. Server only, used by the MCP route
# (src/app/api/mcp/route.ts) and the recurring-service-occurrences cron route
# (src/app/api/cron/recurring-service-occurrences/route.ts). Never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends back as `Authorization: Bearer <value>` when
# it calls /api/cron/recurring-service-occurrences -- generate a random value
# per environment and set it in the Vercel project settings (Production AND
# Preview) before that cron can run there. Never commit the real value.
CRON_SECRET=
